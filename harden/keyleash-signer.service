[Unit]
Description=keyleash Signaturdienst (Härtung Stufe 1)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=keyleash
Group=keyleash
SupplementaryGroups=tss keyleash-clients
Environment=KEYLEASH_TPM=hw KEYLEASH_ENV=/opt/keyleash/keyleash.env KEYLEASH_AGENT_STATE=/var/lib/keyleash
EnvironmentFile=-/etc/keyleash/signer.env
ExecStart=/usr/bin/python3 -I /opt/keyleash/harden/keyleash-signer.py
Restart=on-failure
RestartSec=5

RuntimeDirectory=keyleash
RuntimeDirectoryMode=0755
StateDirectory=keyleash
StateDirectoryMode=0700
UMask=0077

# AppArmor-Profil (das "-" ignoriert es, falls nicht geladen)
AppArmorProfile=-keyleash-signer

# Prozess-Isolation mit systemd-Bordmitteln
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
DevicePolicy=closed
DeviceAllow=/dev/tpmrm0 rw
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
LimitCORE=0
# memfd_secret-Seiten zählen gegen RLIMIT_MEMLOCK
LimitMEMLOCK=4M

[Install]
WantedBy=multi-user.target
